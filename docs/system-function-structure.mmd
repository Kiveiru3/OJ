flowchart TB
    classDef module fill:#ffffff,stroke:#111827,stroke-width:1.6px,color:#111827;
    classDef hub fill:#f8fafc,stroke:#111827,stroke-width:1.8px,color:#111827;
    classDef core fill:#eef2ff,stroke:#111827,stroke-width:2px,color:#111827;

    U["用户端"]:::hub
    S["程序设计评测系统"]:::core
